            "group": "build",
            "label": "package -Pnative (rxlight-api)",
            "command": "${workspaceFolder}/mvnw package -Pnative -pl rxlight",
            "dependsOn": ["install dependencies", "clean rxlight workspace"],
            "dependsOrder": "sequence",
            "windows": {
                "command": "${workspaceFolder}/mvnw.cmd package -Pnative -pl rxlight"
            }
        },
        {
            "type": "shell",
            "isBackground": false,
            "group": "build",
            "label": "clean rxlight workspace",
            "command": "${workspaceFolder}/mvnw clean -pl rxlight",
            "windows": {
                "command": "${workspaceFolder}/mvnw.cmd clean -pl rxlight"
            }
        }
    ],
}