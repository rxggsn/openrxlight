            "group": "build",
            "label": "quarkus:dev (rxlight-api)",
            "command": "export JWT_SECRET='jwt_secret' && ${workspaceFolder}/mvnw quarkus:dev -pl rxlight",
            "dependsOn": ["install dependencies", "clean rxlight workspace"],
            "dependsOrder": "sequence",
            "windows": {
                "command": "${workspaceFolder}/mvnw.cmd quarkus:dev -pl rxlight -Dquarkus.profile=dev"
            }
        },
        {
            "type": "shell",
            "isBackground": false,
