            <groupId>cn.ggsn</groupId>
            <artifactId>openrxlight-sdk</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
